# Live database — binary, changes constantly, not version-controlled.
# Back it up out-of-band; do not commit.
memory.db
memory.db-journal
memory.db-wal
memory.db-shm

# Python
.venv/
__pycache__/
*.pyc

# Build artifacts (from `pip install` / packaging)
build/
*.egg-info/

# Coverage data (the badge SVG at coverage.svg IS committed; the raw data is not)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor / IDE
.idea/
.vscode/
