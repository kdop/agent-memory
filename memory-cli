#!/usr/bin/env python3
"""Thin shim — `memory-cli` delegates to agent_memory.cli:main.

The implementation now lives in the importable `agent_memory` package (src/);
this file is kept on PATH so the `memory-cli` command name and the `memory`
alias (and other repos referencing this path) keep working unchanged (rule #5).

When run from a source checkout that isn't pip-installed, the sibling `src/`
dir is added to sys.path so the package resolves.
"""

import os
import sys

_src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "src")
if os.path.isdir(_src) and _src not in sys.path:
    sys.path.insert(0, _src)

from agent_memory.cli import main

if __name__ == "__main__":
    main()
