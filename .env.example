# Copy to .env (gitignored — never commit real credentials) and fill in.
# Auto-loaded: any command run from this repo (or a subdirectory of it) picks
# this up with no manual `export` — memory-cli, python -m agent_memory.server,
# alembic, scripts/test.sh. A real exported env var always overrides .env.

# ---- Server: the Postgres DSN (Postgres-only) ------------------------------
AGENT_MEMORY_DB=postgresql://user:pass@db-host/memory-bank

# Server: required bearer token — the server refuses to start without one.
AGENT_MEMORY_API_TOKEN=change-me

# Optional — server bind (defaults to 127.0.0.1:8099 if unset).
# AGENT_MEMORY_HOST=127.0.0.1
# AGENT_MEMORY_PORT=8099

# ---- Client (CLI / MCP): where to reach the API ----------------------------
# Defaults to http://127.0.0.1:8099 if unset. Set this when the API runs
# elsewhere (e.g. on the Postgres host, or reached over Tailscale).
# AGENT_MEMORY_API=http://db-host:8099
# AGENT_MEMORY_API_TOKEN=change-me   # same token as the server's, above
